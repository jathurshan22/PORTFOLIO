# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file to GitHub.

PORT=5000

# Use 127.0.0.1 (not localhost) — avoids IPv6 resolution issue in Node 18+
MONGO_URI=mongodb://127.0.0.1:27017/portfolio

# Generate a long random string, e.g:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Optional. Only needed if the frontend is hosted on a DIFFERENT domain
# than this backend. Comma separated, no trailing slash.
# CLIENT_ORIGINS=https://yoursite.com,https://www.yoursite.com

# Used only by: npm run create-admin
# Delete these lines after creating your admin account.
ADMIN_NAME=Your Name
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change_this_password
